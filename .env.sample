PROJECT_SLUG=nasa-notifications
ENVIRONMENT=development

# Next env

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_GA_TRACKING_ID=

# Postgres (образ читает POSTGRES_* напрямую из этого файла)
POSTGRES_USER=nasa
POSTGRES_PASSWORD=nasa
POSTGRES_DB=nasa_notifications

# Подключение приложения к БД. В docker-compose host = postgres, локально — localhost.
# Порт Postgres на хосте; поменяй вместе с DATABASE_URL, если 5432 занят
POSTGRES_PORT=5432
DATABASE_URL=postgres://nasa:nasa@localhost:5432/nasa_notifications

# Максимум карточек, которые лента держит в DOM в live-режиме
NOTICES_LIVE_LIMIT=500

# GCN (gcn.nasa.gov) — только на сервере, никогда не NEXT_PUBLIC_*
GCN_CLIENT_ID=
GCN_CLIENT_SECRET=
# csv топиков; пусто — берётся дефолтный список ingestor'а
GCN_TOPICS=
GCN_BACKFILL_DAYS=7
GCN_CONSUMER_GROUP=nasa-notifications

# AI-чат (docs/16-ai-chat.md) — только на сервере, никогда не NEXT_PUBLIC_*
# Провайдер чата: ollama | anthropic. Эмбеддинги для RAG всегда идут через Ollama.
LLM_PROVIDER=ollama
# Нативный Ollama на Mac — localhost; внутри compose — http://ollama:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Лимиты чата: на IP в минуту / в сутки и общий потолок запросов в сутки
CHAT_RATE_PER_MIN=10
CHAT_RATE_PER_DAY=50
CHAT_DAILY_CAP=1000
